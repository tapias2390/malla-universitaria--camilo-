# =====================================================================
#  Copia este archivo como ".env" y ajusta los valores.
#  NUNCA subas el archivo .env ni las credenciales a un repositorio.
# =====================================================================

# --- JWT ---------------------------------------------------------------
# Clave secreta para firmar los tokens (mínimo 32 caracteres).
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria-de-verdad
JWT_EXPIRACION_MINUTOS=60

# --- Fuente de datos -----------------------------------------------------
# "local" -> lee los Excel desde disco (desarrollo / pruebas)
# "drive" -> descarga los Excel desde Google Drive con una cuenta de servicio
FUENTE_DATOS=local

# Modo local: rutas a los archivos .xlsx
USUARIOS_EXCEL_PATH=data/usuarios.xlsx
ACADEMICO_EXCEL_PATH=data/academico.xlsx

# Modo drive: link (o ID) de cada archivo en Drive. Puede ser un .xlsx
# subido a Drive o una Hoja de cálculo de Google.
USUARIOS_EXCEL_LINK=
ACADEMICO_EXCEL_LINK=
# JSON de la cuenta de servicio de Google (comparte los archivos con su correo)
GOOGLE_CREDENCIALES=credenciales/service_account.json

# Segundos que se guardan en memoria los Excel antes de volver a descargarlos
CACHE_SEGUNDOS=300

# --- Reglas académicas ----------------------------------------------------
# Versión de la malla vigente (la que verán los estudiantes nuevos)
MALLA_VIGENTE=2025
# Nota mínima para considerar una materia aprobada
NOTA_MINIMA=3.0

# --- Tickets --------------------------------------------------------------
TICKETS_PATH=data/tickets.json
